{
  "description": "5 Indonesian stocks that really failed on IDX - monthly closing prices (IDR) up to suspension/delisting",
  "currency": "IDR",
  "data_type": "month-end closing price",
  "period": "2008-01 to 2021-12",
  "purpose": "Counterweight to the survivorship bias of 01_stock_monthly_prices.json, which only contains blue chips that survived 2006-2021. Exactly one of these stocks is added to every game session.",
  "data_quality_notes": [
    "BUMI: real month-end closes from Yahoo Finance (BUMI.JK), which still lists the ticker.",
    "INVS, DAVO, SIAP, BORN: RECONSTRUCTED price paths. Yahoo Finance and the other free feeds no longer serve history for suspended/delisted IDX tickers, so month-end prices are interpolated between publicly documented anchors (IPO/last-traded/reopening prices, suspension and delisting dates, and the Rp 50 IDX price floor). Treat the individual monthly numbers as illustrative; the events, dates and orders of magnitude are real and sourced per stock below.",
    "Rp 50 was the IDX minimum price ('gocap') for the whole period - a stock at 50 that nobody will buy is already a total loss in practice.",
    "A suspended stock keeps its last traded price in this file, which is what the exchange screen showed while trading was halted.",
    "INVS (3 Jul 2009) and BORN (26 Nov 2010) listed after stocks unlock in game year 4, so they only appear in the market from those months ('listed_from').",
    "'sector' stays English on purpose: it is the lookup key for the SECTOR_* localization tokens in Client/wwwroot/localization/*.json, which is what the UI actually renders."
  ],
  "failures": {
    "BUMI": {
      "company_name": "Bumi Resources",
      "sector": "Mining",
      "shariah_compliant": false,
      "residual_value_per_share": 0,
      "fallback_price": 770,
      "what_happened": "Indonesia's biggest coal miner and the most-traded stock on IDX in 2007-2008. Debt-funded acquisitions (KPC, Arutmin) plus the collapse in coal prices took it from an all-time high of Rp 8,750 on 10 Jun 2008 to its all-time low of Rp 50 on 27 Jul 2015. Never delisted, but a buy-and-hold position lost ~98%.",
      "data_quality": "real",
      "price_source": "Yahoo Finance BUMI.JK monthly closes (2008-01 to 2021-12)",
      "sources": [
        "https://www.bareksa.com/berita/berita-ekonomi-terkini/2015-07-28/bumi-sisa-kejayaan-masa-lalu-grup-bakrie-yang-tenggelam-di-dasar-harga-saham",
        "https://www.cnbcindonesia.com/market/20200903141412-17-184165/bangkit-dari-gocap-begini-cerita-bumi-saham-sejuta-umat"
      ]
    },
    "INVS": {
      "company_name": "Inovisi Infracom",
      "sector": "Technology",
      "shariah_compliant": true,
      "listed_from": "2009-07",
      "suspended_from": "2015-02",
      "delisted_on": "2017-10",
      "residual_value_per_share": 2,
      "fallback_price": 125,
      "what_happened": "Telecom-infrastructure small cap that IPO'd on 3 Jul 2009 at Rp 125 and ran to Rp 2,575 by 28 Jun 2013. IDX found errors in its Q3-2014 report and suspended the stock on 13 Feb 2015 at Rp 117; the halt was never lifted and the exchange force-delisted it on 23 Oct 2017. In the negotiated market before the delisting, holders were selling out at around Rp 2 per share.",
      "data_quality": "reconstructed",
      "price_source": "Monthly path reconstructed between documented anchors: Rp 125 IPO (3 Jul 2009), Rp 2,575 all-time high (28 Jun 2013), Rp 117 on the 13 Feb 2015 suspension, and roughly Rp 2 per share in the negotiated market before the 23 Oct 2017 delisting. Quotes are as reported at the time; intermediate months are interpolated.",
      "sources": [
        "https://www.cnnindonesia.com/ekonomi/20171018142100-92-249229/inovisi-infracom-dipastikan-tetap-hengkang-dari-bursa",
        "https://finance.detik.com/bursa-dan-valas/d-3660611/saham-inovisi-dihapus-ada-investor-jual-rugi-rp-2-per-lembar",
        "https://economy.okezone.com/read/2017/09/27/278/1783909/laporan-keuangan-bermasalah-bei-delisting-saham-inovisi-infracom"
      ]
    },
    "DAVO": {
      "company_name": "Davomas Abadi",
      "sector": "Agribusiness",
      "shariah_compliant": false,
      "suspended_from": "2012-03",
      "delisted_on": "2015-01",
      "residual_value_per_share": 0,
      "fallback_price": 76,
      "what_happened": "Cocoa processor that missed the coupon on its USD notes due 7 Mar 2012. IDX suspended the stock on 9 Mar 2012 and never lifted the halt: after almost three years of suspension, going-concern doubts and an office the exchange could no longer locate, DAVO was force-delisted effective 21 Jan 2015. Public shareholders were left with nothing.",
      "data_quality": "reconstructed",
      "price_source": "Monthly path reconstructed around documented events (coupon default Mar 2012, suspension 9 Mar 2012 at the Rp 50 floor, forced delisting 21 Jan 2015). Individual month-end quotes are approximations.",
      "sources": [
        "https://market.bisnis.com/read/20141223/192/385526/januari-2015-saham-davomas-delisting-dari-bei",
        "https://finance.detik.com/bursa-dan-valas/d-2808763/mulai-besok-saham-davomas-tak-lagi-tercatat-di-pasar-modal"
      ]
    },
    "SIAP": {
      "company_name": "Sekawan Intipratama",
      "sector": "Manufacturing",
      "shariah_compliant": true,
      "suspended_from": "2015-11",
      "delisted_on": "2019-06",
      "residual_value_per_share": 0,
      "fallback_price": 64,
      "what_happened": "A small plastics maker that repriced as a coal miner in 2014 and was pumped from the Rp 50 floor to several hundred rupiah before collapsing back. The coal subsidiary never produced a tonne; IDX suspended the stock on 9 Nov 2015 and, after 44 months of suspension, force-delisted it on 17 Jun 2019.",
      "data_quality": "reconstructed",
      "price_source": "Monthly path reconstructed around documented events (2014-2015 pump on the coal story, production halted since Apr 2015, suspension 9 Nov 2015, forced delisting 17 Jun 2019). Individual month-end quotes are approximations.",
      "sources": [
        "https://economy.okezone.com/read/2019/06/14/278/2066398/delisting-saham-sekawan-intipratama-simak-penjelasan-bei",
        "https://insight.kontan.co.id/news/depak-paksa-saham-sekawan-intipratama-siap-bei-bantah-tak-melindungi-investor"
      ]
    },
    "BORN": {
      "company_name": "Borneo Lumbung Energi & Metal",
      "sector": "Mining",
      "shariah_compliant": false,
      "listed_from": "2010-11",
      "suspended_from": "2015-05",
      "delisted_on": "2020-01",
      "residual_value_per_share": 0,
      "fallback_price": 1170,
      "what_happened": "The hottest IPO of 2010: listed on 26 Nov 2010 at Rp 1,170 and raised Rp 3.88 trillion. A USD 1 billion loan taken to buy into Bumi Plc, the collapse in coking-coal prices and the Bakrie-Rothschild fallout wiped the equity out. IDX suspended the stock in 2015 and, after almost five years of suspension, delisted it effective 20 Jan 2020 - the first delisting of that year.",
      "data_quality": "reconstructed",
      "price_source": "Monthly path reconstructed around documented events (IPO 26 Nov 2010 at Rp 1,170, the 2011-2015 slide to the Rp 50 floor, suspension in 2015, delisting effective 20 Jan 2020). Individual month-end quotes are approximations.",
      "sources": [
        "https://economy.okezone.com/read/2010/11/11/278/392187/borneo-lumbung-energy-tetapkan-harga-ipo-rp1170saham",
        "https://www.cnbcindonesia.com/market/20200120165257-17-131360/resmi-delisting-sayonara-borneo-lumbung-energy",
        "https://investasi.kontan.co.id/news/saham-borneo-lumbung-energi-metal-born-delisting-hari-ini"
      ]
    }
  },
